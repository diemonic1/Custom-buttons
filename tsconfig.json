{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "declaration": false,
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "typeRoots": [
      "./.millennium/types",
      "./node_modules/@types"
    ],
    "paths": {
      "millennium": [
        "./.millennium/lsp/ts"
      ]
    }
  },
  "include": [
    "**/*",
    ".millennium/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}